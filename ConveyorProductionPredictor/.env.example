# ============================================================
# Conveyor Belt Production Predictor — configuration locale
# ============================================================
#
# 1) Copiez ce fichier et renommez la copie en .env
# 2) Remplacez YOUR_MYSQL_PASSWORD par VOTRE mot de passe MySQL.
# 3) Ne partagez jamais le fichier .env et ne le publiez pas sur GitHub.
#
# Si cette ligne est absente ou invalide, l'application utilisera SQLite
# automatiquement : instance/conveyor.db

DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/conveyor_production_predictor_db

# Clé utilisée par Flask pour les sessions et messages.
# Remplacez cette valeur par une phrase aléatoire personnelle.
FLASK_SECRET_KEY=replace-with-a-long-random-personal-secret
